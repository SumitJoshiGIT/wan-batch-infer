{
  "_meta": "Wan2.2 I2V 14B start AND end frame conditioning (WanFirstLastFrameToVideo), GGUF dual-expert + lightx2v 4-step LoRA. Derived from ComfyUI's official video_wan2_2_14B_flf2v.json (the fast group): high-noise expert samples steps 0..split, low-noise expert samples split..end, both at cfg 1 with shift 5. GGUF rather than fp8_scaled because a free Colab/Kaggle T4 has no fp8 support. This engine is for REMOTE batching only: the weights do not exist on this laptop. Build the graph locally with `vid export-batch --engine wan14`, run it on the remote GPU, bring the frames back with `vid import-clips`.",
  "1": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "{{unet_high}}"}, "_meta": {"title": "14B high-noise expert (GGUF)"}},
  "2": {"class_type": "CLIPLoaderGGUF", "inputs": {"clip_name": "{{clip}}", "type": "{{clip_type}}"}, "_meta": {"title": "umt5-xxl (GGUF)"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
  "4": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "{{lora_high}}", "strength_model": "{{lora_strength}}"}, "_meta": {"title": "lightx2v 4-step LoRA (high)"}},
  "5": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["4", 0], "shift": "{{shift}}"}},
  "6": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "{{unet_low}}"}, "_meta": {"title": "14B low-noise expert (GGUF)"}},
  "7": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["6", 0], "lora_name": "{{lora_low}}", "strength_model": "{{lora_strength}}"}, "_meta": {"title": "lightx2v 4-step LoRA (low)"}},
  "8": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["7", 0], "shift": "{{shift}}"}},
  "9": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "{{prompt}}"}, "_meta": {"title": "Motion prompt"}},
  "10": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "{{negative}}"}, "_meta": {"title": "Negative prompt"}},
  "11": {"class_type": "LoadImage", "inputs": {"image": "{{image}}"}, "_meta": {"title": "Start keyframe"}},
  "12": {"class_type": "LoadImage", "inputs": {"image": "{{end_image}}"}, "_meta": {"title": "End keyframe"}},
  "13": {"class_type": "WanFirstLastFrameToVideo", "inputs": {"positive": ["9", 0], "negative": ["10", 0], "vae": ["3", 0],
         "width": "{{width}}", "height": "{{height}}", "length": "{{length}}", "batch_size": 1,
         "start_image": ["11", 0], "end_image": ["12", 0]}},
  "14": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["5", 0], "positive": ["13", 0], "negative": ["13", 1],
         "latent_image": ["13", 2], "add_noise": "enable", "noise_seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
         "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "start_at_step": 0, "end_at_step": "{{split}}",
         "return_with_leftover_noise": "enable"}, "_meta": {"title": "High-noise expert"}},
  "15": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["8", 0], "positive": ["13", 0], "negative": ["13", 1],
         "latent_image": ["14", 0], "add_noise": "disable", "noise_seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
         "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "start_at_step": "{{split}}", "end_at_step": 10000,
         "return_with_leftover_noise": "disable"}, "_meta": {"title": "Low-noise expert"}},
  "16": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["15", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64,
         "temporal_size": 64, "temporal_overlap": 8}},
  "17": {"class_type": "SaveImage", "inputs": {"images": ["16", 0], "filename_prefix": "{{prefix}}"}}
}
